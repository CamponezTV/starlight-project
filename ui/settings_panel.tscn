[gd_scene format=3]

[ext_resource type="Script" path="res://ui/settings_panel.gd" id="1_panel"]
[ext_resource type="Script" path="res://ui/option_row.gd" id="2_row"]
[ext_resource type="AudioStream" path="res://menu/sounds/ui_move.wav" id="3_step"]

[node name="SettingsPanel" type="VBoxContainer"]
custom_minimum_size = Vector2(204, 0)
theme_override_constants/separation = 1
script = ExtResource("1_panel")

[node name="Language" type="Button" parent="."]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"MenuItem"
text = "Idioma"
alignment = 0
script = ExtResource("2_row")

[node name="MasterVolume" type="Button" parent="."]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"MenuItem"
text = "Volume geral"
alignment = 0
script = ExtResource("2_row")
pips = 10

[node name="MusicVolume" type="Button" parent="."]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"MenuItem"
text = "Música"
alignment = 0
script = ExtResource("2_row")
pips = 10

[node name="SfxVolume" type="Button" parent="."]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"MenuItem"
text = "Efeitos sonoros"
alignment = 0
script = ExtResource("2_row")
pips = 10

[node name="AutoText" type="Button" parent="."]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"MenuItem"
text = "Texto automático"
alignment = 0
script = ExtResource("2_row")

[node name="Display" type="Button" parent="."]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"MenuItem"
text = "Tela"
alignment = 0
script = ExtResource("2_row")

[node name="Back" type="Button" parent="."]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"MenuItem"
text = "Voltar"
alignment = 0

[node name="StepSound" type="AudioStreamPlayer" parent="."]
stream = ExtResource("3_step")
volume_db = -8.0
bus = &"SFX"
