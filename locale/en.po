msgid "Final 1"
msgstr "Ending 1"

#: menu/menu.tscn
msgid "Final 2"
msgstr "Ending 2"

#: menu/menu.tscn
msgid "uma história sobre não ter pressa"
msgstr "a story about taking your time"

#: menu/menu.tscn, ui/pause_menu.tscn
msgid "Continuar"
msgstr "Continue"

#: menu/menu.tscn
msgid "Novo jogo"
msgstr "New game"

#: menu/menu.tscn
msgid "Capítulos"
msgstr "Chapters"

